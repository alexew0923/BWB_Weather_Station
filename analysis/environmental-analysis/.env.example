# Copy to .env and fill in the real values. .env is never committed.
#
# These are the same settings the rest of the repository already uses; the
# engine does not introduce a parallel configuration scheme.

# Required. The historical telemetry Sheet. Either a normal Google Sheets link
# or a CSV export URL -- the engine normalises the first into the second.
HISTORICAL_DATA_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit?gid=YOUR_GID#gid=YOUR_GID

# Optional. The live telemetry Sheet, shared with StationWatch. Only needed for
# the current-conditions view.
STATIONWATCH_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Optional, development only. When set, the engine reads this local CSV instead
# of the remote Sheet. Never set it in a deployment: it is an override for
# reproducible local work, not a fallback.
# BWB_ENVIRONMENTAL_CSV=/path/to/HistoricalData.csv
